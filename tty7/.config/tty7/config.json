{
  "font_family": "JetBrains Mono",
  "font_fallbacks": [
    "Menlo",
    "Hasklug Nerd Font Mono",
    "Maple Mono NF CN",
    "PingFang SC",
    "Apple Color Emoji"
  ],
  "font_family_bold": null,
  "font_family_italic": null,
  "font_features": null,
  "font_size": 16.0,
  "line_height": 1.4,
  "theme": "Nord",
  "theme_preset": "Nord",
  "theme_follow_system": false,
  "theme_preset_light": "light",
  "theme_preset_dark": "dark",
  "theme_legible_palette": true,
  "window_opacity": 0.9,
  "window_blur": true,
  "dim_inactive_panes": true,
  "keybindings": {},
  "keybinding_preset": "default",
  "prefix": "ctrl-b",
  "shell": null,
  "link_url": true,
  "link_file_command": null,
  "ssh_loopback_forward": false,
  "cursor_blink": true,
  "scrollback_limit": 10000,
  "new_tab_position": "after-current",
  "tab_bar_position": "left",
  "sidebar_width": 220.0,
  "sidebar_collapsed": false,
  "right_panel_visible": false,
  "right_panel_width": 260.0,
  "right_panel_tab": "info",
  "sidebar_grouping": "repo",
  "sidebar_diff_preview": true,
  "notify_on_command_finish": "unfocused",
  "check_for_updates": true,
  "update_channel": "stable",
  "auto_download_updates": true,
  "install_cli_on_path": true,
  "gui_language": "en",
  "notify_threshold_secs": 10,
  "restore_session": true,
  "show_tray_icon": true,
  "bell": "visual",
  "tab_completion": true,
  "history_search": true,
  "cursor_style": "block",
  "macos_option_as_alt": false,
  "mouse_hide_while_typing": true,
  "focus_follows_mouse": false,
  "mouse_scroll_multiplier": 1.0,
  "smooth_scroll": true,
  "mouse_reporting": true,
  "clipboard_trim_trailing_spaces": false,
  "copy_on_select": false,
  "http_proxy": null,
  "smart_select": true,
  "word_separators": ",│`|:\"' ()[]{}<>\t",
  "startup_mode": "normal",
  "remember_window_size": true,
  "working_directory": {
    "strategy": "inherit",
    "path": ""
  },
  "env": {},
  "ssh_profiles": [],
  "verify_host_keys": true,
  "ssh_warn_on_close": false,
  "ssh_profile_frecency": {},
  "command_frecency": {},
  "agent_commands": {},
  "restore_agent_sessions": true
}
