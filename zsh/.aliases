# System
if command -v eza >/dev/null 2>&1; then
  alias ls='eza'
  alias l='eza -lbF --git'
  alias ll='eza -lbGF --git'
else
  alias l='ls -lF'
  alias ll='ls -laF'
fi
command -v bat >/dev/null 2>&1 && alias cat='bat'
alias mkdir='mkdir -p'
alias reload="source ~/.zshrc && exec $SHELL -l"

# Kubernetes
alias kc="kubectl"
alias kcx="kubectx"
alias kcns="kubens"
alias offlinepg="kubectl port-forward deploy/db-auth-proxy 5431:5432"

kcexec() {
  kubectl exec -it $1 -- sh
}

# Docker
alias dcu="docker-compose up"
alias dcd="docker-compose down"

# gcloud
if [[ $OSTYPE == linux* ]]; then
  alias gal="gcloud auth login --update-adc --no-launch-browser"
else
  alias gal="gcloud auth login --update-adc"
fi

# Tools
alias pn="pnpm"
alias rd="revdiff"
[[ -x /opt/homebrew/bin/zed ]] && alias authzed="/opt/homebrew/bin/zed"

# Outpost
# Bring up Rex on an Outpost instance and the forward the Rex app reaches it by.
# A new instance keeps only the data disk, so Rex lives in ~/.local/bin and runs
# as a systemd user service, and the bash login shell of the image hands Rex
# terminals to zsh, since chsh needs root and dies with the instance. The server
# listens only on its Unix socket; scripts/outpost-rex-forward, built here and
# kept up by a launchd agent, carries it to a loopback port.
# Usage: outpost-rex [host]
outpost-rex() {
  emulate -L zsh
  local host=${1:-outpost} port sock dir token src bin label plist tmp
  port=$(( 7297 + $(cksum <<<"$host" | cut -d' ' -f1) % 1000 ))

  sock=$(ssh "$host" 'bash -s' <<'EOF'
set -euo pipefail
bin=~/.local/bin/rex
rel=$(curl -fsSL --retry 3 https://blob.superlogical.com/api/releases/rex/snapshot)
if [ "$("$bin" version 2>/dev/null | sed -n 's/^commit: //p')" != "$(jq -r .commit <<<"$rel")" ]; then
  art=$(jq -c --arg f "rex-linux-$(dpkg --print-architecture).tar.gz" '.artifacts[] | select(.filename == $f)' <<<"$rel")
  dir=$(mktemp -d)
  trap 'rm -rf "$dir"' EXIT
  curl -fsSL --retry 3 -o "$dir/rex.tgz" "$(jq -r .downloadUrl <<<"$art")"
  echo "$(jq -r .sha256 <<<"$art")  $dir/rex.tgz" | sha256sum -c --quiet >&2
  tar -xzf "$dir/rex.tgz" -C "$dir"
  install -Dm755 "$dir/rex" "$bin"
  echo "installed $("$bin" version | head -1); the server runs it from its next start" >&2
fi

mkdir -p ~/.config/systemd/user
cat >~/.config/systemd/user/rex.service <<'UNIT'
[Unit]
Description=Rex server

[Service]
ExecStart=%h/.local/bin/rex server run
Restart=on-failure

[Install]
WantedBy=default.target
UNIT
systemctl --user daemon-reload
systemctl --user enable --now rex.service 2>/dev/null
"$bin" terminfo setup >/dev/null

grep -qs REX_SESSION ~/.bashrc || cat >>~/.bashrc <<'RC'

# Rex starts terminals in the passwd shell, which every new Outpost instance resets to bash.
[[ $- == *i* && -n ${REX_SESSION:-} ]] && exec zsh -l
RC
echo "/run/user/$(id -u)/rex/server.sock"
EOF
  ) || return 1

  # The forward admits only clients that present this token; see its source.
  dir=~/Library/Application\ Support/outpost-rex-forward
  mkdir -p -m 700 "$dir" || return 1
  [[ -s $dir/$host.token ]] || (umask 077 && openssl rand -hex 16 >"$dir/$host.token") || return 1
  token=$(<"$dir/$host.token")

  src=${functions_source[outpost-rex]:A:h:h}/scripts/outpost-rex-forward
  bin=$dir/outpost-rex-forward
  if [[ ! -x $bin || -n $(find "$src" -newer "$bin" -type f) ]]; then
    (cd "$src" && go build -o "$bin" .) || return 1
  fi

  label=dotfiles.rex-forward.$host
  plist=~/Library/LaunchAgents/$label.plist
  tmp=$(mktemp) || return 1
  plutil -create xml1 "$tmp" &&
    plutil -insert Label -string "$label" "$tmp" &&
    plutil -insert ProgramArguments -json "$(jq -nc --arg b "$bin" --arg h "$host" --arg p "$port" --arg s "$sock" '[$b, $h, $p, $s]')" "$tmp" &&
    plutil -insert StandardErrorPath -string ~/Library/Logs/$label.log "$tmp" &&
    plutil -insert EnvironmentVariables -json "$(jq -nc --arg p "${commands[cloudflared]:h}:/usr/bin:/bin" '{PATH: $p}')" "$tmp" &&
    plutil -insert RunAtLoad -bool true "$tmp" &&
    plutil -insert KeepAlive -bool true "$tmp" || { rm -f "$tmp"; return 1; }
  # A rebuilt binary also needs a restart, which only a changed plist gets.
  if [[ $bin -nt $plist ]] || ! cmp -s "$tmp" "$plist"; then
    mv "$tmp" "$plist"
    launchctl bootout "gui/$UID/$label" 2>/dev/null
  else
    rm -f "$tmp"
  fi
  launchctl print "gui/$UID/$label" >/dev/null 2>&1 || launchctl bootstrap "gui/$UID" "$plist" || return 1

  rex hosts edit "$host" --endpoint "http://$token@127.0.0.1:$port" >/dev/null 2>&1 ||
    rex hosts add "$host" "http://$token@127.0.0.1:$port" --icon server >/dev/null || return 1

  # The Rex app keeps hosts of its own, read only at launch, that no CLI or
  # config reaches, so write this one into its private store. Stop at a format
  # this doesn't know rather than guess.
  local servers
  tmp=$(mktemp) || return 1
  defaults export com.superlogical.rex "$tmp" &&
    servers=$(/usr/libexec/PlistBuddy -c 'Print :RexSync.servers' "$tmp" 2>/dev/null)
  rm -f "$tmp"
  servers=${servers:-'{"formatVersion":1,"records":[]}'}
  if ! jq -e '.formatVersion == 1' <<<"$servers" >/dev/null 2>&1; then
    echo "Add $host in the Rex app by hand (Add Remote Host…): its host store changed format" >&2
  elif ! jq -e --arg h "$host" --arg l "http://$token@127.0.0.1:$port" \
    'any(.records[]; .name == $h and .locators == [$l])' <<<"$servers" >/dev/null; then
    servers=$(jq -c --arg h "$host" --arg t "$token" --arg u "http://127.0.0.1:$port" --arg id "$(uuidgen)" '
      (first(.records[] | select(.name == $h) | .id) // $id) as $id
      | .records = [.records[] | select(.name != $h)] + [{
          id: $id, name: $h, icon: "server", preferredAccount: $t, preferredURL: $u,
          locators: ["http://\($t)@\($u | ltrimstr("http://"))"]}]' <<<"$servers") &&
      defaults write com.superlogical.rex RexSync.servers -data "$(printf %s "$servers" | xxd -p | tr -d '\n')" &&
      echo "Added $host to the Rex app; quit and reopen it to see the host" >&2
  fi

  # The forward retries every 10s, so give it a couple of rounds.
  local i
  for i in {1..30}; do
    rex -S "$host" server status >/dev/null 2>&1 && return
    sleep 1
  done
  echo "Rex on $host is unreachable at 127.0.0.1:$port" >&2
  return 1
}

# Wake an Outpost instance and bring its Rex server back within reach.
# The forward can't open a browser for Cloudflare Access, so an expired token
# keeps it down until the login happens here.
# Usage: outpost-up [name]
outpost-up() {
  emulate -L zsh
  local name=$1 host=outpost${1:+-$1} app
  for app in outpost-api.dcard.io outpost-ssh.dcard.io; do
    cloudflared access token --app "https://$app" >/dev/null 2>&1 && continue
    cloudflared access login --app "https://$app" >/dev/null || return 1
  done
  # claim, not start: start fails once the instance has been released, and
  # claim also resumes a stopped one.
  if ! outpost status $name | grep -q '^Status *running$'; then
    outpost claim $name --instance-type e6-standard-8 || return 1
  fi
  outpost-rex "$host" || return 1
  echo "$host ready"
}

# Git
# Remove worktrees and branches whose upstream was deleted on the remote
# (covers squash/rebase merges, unlike `git branch --merged`).
# Usage: git-clean-merged [-n|--dry-run] [-f|--force] [protected_regex]
#   protected_regex defaults to: main|master|develop
#   -n  print actions without executing
#   -f  pass --force to `git worktree remove` (allows dirty worktrees)
git-clean-merged() {
  emulate -L zsh
  setopt local_options pipe_fail

  local dry_run=0 force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n|--dry-run) dry_run=1; shift ;;
      -f|--force)   force=1;   shift ;;
      --) shift; break ;;
      -*) echo "Unknown flag: $1" >&2; return 2 ;;
      *)  break ;;
    esac
  done
  local protected="${1:-main|master|develop}"

  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "Not a git repository" >&2
    return 1
  fi

  if (( dry_run )); then
    echo "→ (dry-run) skipping fetch"
  else
    echo "→ git fetch --all --prune"
    git fetch --all --prune || return $?
  fi

  local gone
  gone=$(git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads \
    | awk -v p="$protected" '$2=="[gone]" && $1 !~ "^("p")$" {print $1}')

  if [[ -z "$gone" ]]; then
    echo "Nothing to clean."
    return 0
  fi

  # Refuse if currently on a branch slated for deletion (avoids removing our own worktree).
  local current_branch
  current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
  if [[ -n "$current_branch" && "$current_branch" != "HEAD" ]] \
     && grep -qFx "$current_branch" <<< "$gone"; then
    echo "Refusing: current branch '$current_branch' is in the cleanup list." >&2
    echo "         Switch to a protected branch (e.g. main) first." >&2
    return 1
  fi

  # Build branch -> worktree path map; parse porcelain by line to handle paths with spaces.
  typeset -A wt_for_branch
  local line wt_path=""
  while IFS= read -r line; do
    case "$line" in
      "worktree "*)         wt_path="${line#worktree }" ;;
      "branch refs/heads/"*) wt_for_branch[${line#branch refs/heads/}]="$wt_path" ;;
    esac
  done < <(git worktree list --porcelain)

  local -i fail=0
  local br wt

  echo "→ Worktrees"
  while IFS= read -r br; do
    [[ -z "$br" ]] && continue
    wt="${wt_for_branch[$br]:-}"
    [[ -z "$wt" ]] && continue
    if (( dry_run )); then
      echo "  would remove: $wt ($br)"
      continue
    fi
    local -a rm_args=(worktree remove)
    (( force )) && rm_args+=(--force)
    rm_args+=("$wt")
    if git "${rm_args[@]}"; then
      echo "  removed: $wt ($br)"
    else
      echo "  FAILED: $wt ($br) — re-run with -f to force" >&2
      (( fail++ ))
    fi
  done <<< "$gone"

  echo "→ Branches"
  while IFS= read -r br; do
    [[ -z "$br" ]] && continue
    wt="${wt_for_branch[$br]:-}"
    # Skip if worktree removal failed (dir still present).
    if (( ! dry_run )) && [[ -n "$wt" && -d "$wt" ]]; then
      echo "  skip: $br (worktree still present at $wt)"
      (( fail++ ))
      continue
    fi
    if (( dry_run )); then
      echo "  would delete: $br"
      continue
    fi
    if git branch -D "$br"; then
      echo "  deleted: $br"
    else
      echo "  FAILED: $br" >&2
      (( fail++ ))
    fi
  done <<< "$gone"

  return $fail
}

# Local overrides
[[ -f ~/.aliases.local ]] && source ~/.aliases.local
